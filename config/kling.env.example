# Kling AI image-to-video add-on for the Carbo MCP Gateway.
#
# NON-SECRET. Copy to config/kling.env (git-ignored via *.env). The credential
# is always a FILE PATH inside the container, never a value, so nothing
# sensitive shows up in `docker inspect` or a process listing.
#
# Authentication (https://kling.ai/document-api, "Authentication", read 2026-09-11):
#   Kling accepts either an API Key, sent verbatim as a Bearer token and valid
#   for all models, or an Access Key / Secret Key pair, from which the gateway
#   signs a short-lived HS256 JWT itself. Configure ONE of the two.

# --- credential (choose one scheme) --------------------------------------------
KLING_API_KEY_FILE=/run/secrets/kling_api_key
#KLING_ACCESS_KEY_FILE=/run/secrets/kling_access_key
#KLING_SECRET_KEY_FILE=/run/secrets/kling_secret_key

# --- enablement ------------------------------------------------------------------
# The kling_* tools are Level 3 (they reach a third party; animate is PAID).
# They are registered only when a credential exists AND their names appear
# here. Remove a name to switch that tool off without touching anything else.
MCP_ELEVATED_TOOLS=kling_animate_image,kling_video_status,kling_download_video

# --- endpoints and paths ---------------------------------------------------------
# Kling's endpoint for callers outside China.
KLING_API_BASE=https://api-singapore.klingai.com
# Read-only directory of approved starting images. docker-compose.kling.yml
# binds it from /mnt/carbo-folder/Videos/Kling/input, i.e. the share
# \\10.0.0.39\CarboFolder\Videos\Kling\input.
KLING_INPUT_DIR=/app/kling/input
# The only place result videos are written: /mnt/carbo-folder/Videos/Kling.
KLING_OUTPUT_DIR=/app/kling/output
# Prefix for the link kling_download_video returns. A UNC path (backslashes),
# a host path, or a URL; the filename is joined with the matching separator.
KLING_OUTPUT_LINK_BASE=\\10.0.0.39\CarboFolder\Videos\Kling
# Hard cap on a single downloaded video (bytes). 512 MiB.
KLING_MAX_DOWNLOAD_BYTES=536870912

# --- timeouts --------------------------------------------------------------------
# A video download can outlast the 30 s default request timeout. This file is
# loaded after gateway.env, so it overrides that one value only.
MCP_REQUEST_TIMEOUT_MS=90000
