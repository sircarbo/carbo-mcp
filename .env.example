# Copy to .env before deploying. Contains NO secrets -- credentials live as
# files in ./secrets/ and reach the containers as Docker secrets.

# Both services bind the Tailscale address only. They are reachable from the
# tailnet (which is how the VPS reverse proxy reaches them) and nowhere else.
CARBO_MCP_BIND_ADDR=100.71.174.8
CARBO_MCP_PORT=8110
CARBO_KEYCLOAK_PORT=8111

CARBO_MCP_PUBLIC_ORIGIN=https://mcp.carbocomputers.com
CARBO_KEYCLOAK_REALM=carbo
